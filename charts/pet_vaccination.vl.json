
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Vaccination Rates Among Dogs and Cats (2025)",
    "subtitle": "Lifetime vaccination versus vaccination in the past 12 months"
  },

  "width": "container",
  "height": 180,

  "data": {
    "url": "data/pet_vaccination.csv",
    "format": {
      "type": "csv"
    }
  },

  "encoding": {
    "y": {
      "field": "pet_type",
      "type": "nominal",
      "sort": ["Dogs", "Cats"],
      "title": null
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#A9B8C6",
        "strokeWidth": 4
      },

      "encoding": {
        "x": {
          "field": "past_12_months",
          "type": "quantitative",
          "title": "Vaccination Rate (%)",
          "scale": {
            "domain": [0, 100]
          },
          "axis": {
            "values": [0, 20, 40, 60, 80, 100]
          }
        },

        "x2": {
          "field": "ever_vaccinated"
        }
      }
    },

    {
      "transform": [
        {
          "fold": [
            "ever_vaccinated",
            "past_12_months"
          ],
          "as": ["vaccination_type", "rate"]
        },

        {
          "calculate": "datum.vaccination_type === 'ever_vaccinated' ? 'Ever vaccinated' : 'Past 12 months'",
          "as": "vaccination_label"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 180
      },

      "encoding": {
        "x": {
          "field": "rate",
          "type": "quantitative"
        },

        "color": {
          "field": "vaccination_label",
          "type": "nominal",
          "title": "Vaccination Status",
          "scale": {
            "domain": [
              "Ever vaccinated",
              "Past 12 months"
            ],
            "range": [
              "#4C78A8",
              "#E49F52"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },

        "tooltip": [
          {
            "field": "pet_type",
            "type": "nominal",
            "title": "Pet Type"
          },
          {
            "field": "vaccination_label",
            "type": "nominal",
            "title": "Vaccination Status"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Rate (%)",
            "format": ".0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "fold": [
            "ever_vaccinated",
            "past_12_months"
          ],
          "as": ["vaccination_type", "rate"]
        },

        {
          "calculate": "format(datum.rate, '.0f') + '%'",
          "as": "rate_label"
        }
      ],

      "mark": {
        "type": "text",
        "dy": -17,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#253447"
      },

      "encoding": {
        "x": {
          "field": "rate",
          "type": "quantitative"
        },

        "text": {
          "field": "rate_label",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "view": {
      "stroke": null
    }
  }
}
